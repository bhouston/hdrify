{
  "name": "hdrify-react",
  "version": "1.1.3",
  "description": "React component and <image-viewer> web component for displaying HDR images with tone mapping and exposure",
  "keywords": [
    "exr",
    "float-image",
    "gainmap",
    "hdr",
    "image-viewer",
    "openexr",
    "radiance",
    "react",
    "tone-mapping",
    "ultra-hdr",
    "web-component"
  ],
  "bugs": {
    "url": "https://github.com/bhouston/hdrify/issues"
  },
  "license": "MIT",
  "author": "Ben Houston <neuralsoft@gmail.com> (https://ben3d.ca)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bhouston/hdrify.git",
    "directory": "packages/hdrify-react"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/element.js",
    "./dist/image-viewer.js"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "default": "./dist/element.js"
    },
    "./image-viewer.js": "./dist/image-viewer.js",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json",
    "./decode": {
      "types": "./dist/decode.d.ts",
      "default": "./dist/decode.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc && node scripts/build-element.mjs",
    "tsc": "tsc --noEmit",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "hdrify": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@webgpu/types": "^0.1.74",
    "esbuild": "^0.27.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
