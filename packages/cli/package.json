  },
  "scripts": {
    "build": "tsc",
    "tsc": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "hdrify": "workspace:*",
    "sharp": "^0.34.5",
    "yargs": "^18.0.0",
    "yargs-file-commands": "^1.2.2"
  },
  "devDependencies": {
    "@types/yargs": "^17.0.35"
  }
