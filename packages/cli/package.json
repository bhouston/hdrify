{
  "name": "hdrify-cli",
  "version": "0.12.1",
  "description": "CLI tool for converting between EXR and HDR and Ultra JPEG-R formats",
  "keywords": [
    "cli",
    "command-line",
    "exr",
    "format",
    "gainmap",
    "hdr",
    "image",
    "jpeg-r",
    "openexr",
    "parser",
    "radiance",
    "rgbe",
    "tool",
    "ultra-hdr",
    "writer"
  ],
  "bugs": {
    "url": "https://github.com/bhouston/hdrify/issues"
  },
  "license": "MIT",
  "author": "Ben Houston <neuralsoft@gmail.com> (https://ben3d.ca)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bhouston/hdrify.git",
    "directory": "packages/cli"
  },
  "bin": {
    "hdrify": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.js",
  "publishConfig": {
    "access": "public",
