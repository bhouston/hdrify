{
  "name": "hdrify-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "clean": "rimraf dist packages/**/dist .nx node_modules packages/**/node_modules",
    "check": "pnpm lint && pnpm format",
    "tsc": "tsgo -b",
    "tsgo": "pnpm -r tsgo",
    "test": "pnpm vitest",
    "test:profile": "PROFILE=1 pnpm vitest run --no-coverage",
    "test:profile:main": "node --cpu-prof --cpu-prof-dir=./profile-output ./node_modules/vitest/vitest.mjs run --no-coverage",
    "profile:analyze": "node scripts/analyze-cpuprofile.mjs",
    "format": "oxfmt .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "cloc": "npx cloc * --exclude-dir=node_modules,dist,.nx,.next,build",
    "make-release:hdrify": "node scripts/make-release.ts packages/hdrify",
    "make-release:hdrify-cli": "node scripts/make-release.ts packages/cli",
    "make-release:hdrify-react": "node scripts/make-release.ts packages/hdrify-react",
    "hdrify": "node ./packages/cli/dist/index.js"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@typescript/native-preview": "7.0.0-dev.20251229.1",
    "@vitest/coverage-v8": "^2.1.9",
    "chalk": "^5.6.2",
    "fflate": "^0.8.2",
    "glob": "^13.0.0",
    "husky": "^9.1.7",
    "jsonfile": "^6.2.0",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.56.0",
    "prompt-confirm": "^2.0.4",
    "rimraf": "^6.0.1",
    "semver": "^7.7.3",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.17.0",
  "pnpm": {
    "overrides": {
      "esbuild": "0.27.3"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "@tailwindcss/oxide"
    ]
  }
}
