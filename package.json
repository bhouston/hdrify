{
  "name": "hdrify-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "clean": "rimraf dist packages/**/dist .nx node_modules packages/**/node_modules",
    "tsc": "pnpm -r tsc",
    "test": "vitest run",
    "test:profile": "PROFILE=1 pnpm vitest run --no-coverage",
    "test:profile:main": "node --cpu-prof --cpu-prof-dir=./profile-output ./node_modules/vitest/vitest.mjs run --no-coverage",
    "profile:analyze": "node scripts/analyze-cpuprofile.mjs",
    "format": "oxfmt .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "cloc": "npx cloc * --exclude-dir=node_modules,dist,.nx,.next,build",
    "hdrify": "node ./packages/cli/dist/index.js",
    "release": "semantic-release",
    "release:check": "node --test scripts/release.test.mjs",
    "size": "size-limit"
  },
  "devDependencies": {
    "@anolilab/semantic-release-pnpm": "^8.1.25",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@size-limit/preset-small-lib": "^14.0.0",
    "@types/node": "^24",
    "@visulima/yaml": "1.0.0",
    "@vitest/coverage-v8": "^5.0.1",
    "chalk": "^5.6.2",
    "conventional-changelog-conventionalcommits": "^10.4.0",
    "fflate": "^0.8.2",
    "glob": "^13.0.0",
    "husky": "^9.1.7",
    "jsonfile": "^6.2.0",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "prompt-confirm": "^2.0.4",
    "rimraf": "^6.1.3",
    "semantic-release": "^25.0.9",
    "semver": "^7.7.3",
    "size-limit": "^14.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "oxfmt",
      "oxlint --fix"
    ],
    "*.{json,jsonc,md,mdx,css,html,yml,yaml}": "oxfmt"
  },
  "size-limit": [
    {
      "name": "hdrify browser bundle",
      "path": "packages/hdrify/dist/index.js",
      "limit": "50 kB"
    },
    {
      "name": "hdrify-react browser bundle",
      "path": "packages/hdrify-react/dist/index.js",
      "ignore": [
        "react",
        "react-dom"
      ],
      "limit": "22 kB"
    }
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.27.0"
}
